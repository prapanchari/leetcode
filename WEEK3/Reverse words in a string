#include <string.h>

void reverseRange(char* s, int start, int end) {
    while (start < end) {
        char temp = s[start];
        s[start] = s[end];
        s[end] = temp;
        start++;
        end--;
    }
}

char* reverseWords(char* s) {
    int len = strlen(s);
    int write = 0;
    int i = 0;
    
    while (i < len) {
        while (i < len && s[i] == ' ') i++;
        if (i == len) break;
        
        if (write > 0) {
            s[write++] = ' ';
        }
        
        int wordStart = write;
        while (i < len && s[i] != ' ') {
            s[write++] = s[i++];
        }
        reverseRange(s, wordStart, write - 1);
    }
    
    s[write] = '\0';
    reverseRange(s, 0, write - 1);
    
    return s;
}
