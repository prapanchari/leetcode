#include <stdbool.h>
#include <stdlib.h>

bool find132pattern(int* nums, int numsSize) {
    if (numsSize < 3) {
        return false;
    }
    
    int* stack = (int*)malloc(numsSize * sizeof(int));
    int top = 0;
    int num3 = -2e9 - 7;
    
    for (int i = numsSize - 1; i >= 0; i--) {
        if (nums[i] < num3) {
            free(stack);
            return true;
        }
        
        while (top > 0 && nums[i] > stack[top - 1]) {
            num3 = stack[--top];
        }
        
        stack[top++] = nums[i];
    }
    
    free(stack);
    return false;
}
