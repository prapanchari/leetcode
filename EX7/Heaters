#include <stdlib.h>
#include <math.h>

int compare(const void* a, const void* b) {
    return (*(int*)a > *(int*)b) - (*(int*)a < *(int*)b);
}

int findRadius(int* houses, int housesSize, int* heaters, int heatersSize) {
    qsort(heaters, heatersSize, sizeof(int), compare);
    int minRadius = 0;
    
    for (int i = 0; i < housesSize; i++) {
        int house = houses[i];
        
        int low = 0;
        int high = heatersSize - 1;
        while (low < high) {
            int mid = low + (high - low) / 2;
            if (heaters[mid] < house) {
                low = mid + 1;
            } else {
                high = mid;
            }
        }
        
        int dist1 = abs(heaters[low] - house);
        int dist2 = (low > 0) ? abs(heaters[low - 1] - house) : 2e9 + 7;
        
        int localMinDist = (dist1 < dist2) ? dist1 : dist2;
        if (localMinDist > minRadius) {
            minRadius = localMinDist;
        }
    }
    
    return minRadius;
}
