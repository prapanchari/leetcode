#include <stdlib.h>

struct ListNode* createNode(int val) {
    struct ListNode* newNode = (struct ListNode*)malloc(sizeof(struct ListNode));
    newNode->val = val;
    newNode->next = NULL;
    return newNode;
}

struct ListNode* addTwoNumbers(struct ListNode* l1, struct ListNode* l2) {
    int s1[105], s2[105]; 
    int top1 = -1, top2 = -1;

    while (l1 != NULL) {
        s1[++top1] = l1->val;
        l1 = l1->next;
    }

    while (l2 != NULL) {
        s2[++top2] = l2->val;
        l2 = l2->next;
    }

    int carry = 0;
    struct ListNode* head = NULL;

    while (top1 >= 0 || top2 >= 0 || carry > 0) {
        int val1 = (top1 >= 0) ? s1[top1--] : 0;
        int val2 = (top2 >= 0) ? s2[top2--] : 0;

        int total = val1 + val2 + carry;
        carry = total / 10;

        struct ListNode* newNode = createNode(total % 10);
        newNode->next = head;
        head = newNode;
    }

    return head;
}
