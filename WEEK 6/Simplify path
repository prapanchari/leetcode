#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* simplifyPath(char* path) {
    int len = strlen(path);
    // Allocate space for token pointer arrays (Stack)
    char** stack = (char**)malloc(len * sizeof(char*));
    int top = -1;

    // Use strtok to split the absolute path by slashes safely
    char* token = strtok(path, "/");
    while (token != NULL) {
        if (strcmp(token, "..") == 0) {
            if (top >= 0) {
                top--; // Move to the parent directory
            }
        } else if (strcmp(token, ".") != 0 && strlen(token) > 0) {
            stack[++top] = token; // Push valid directory or file name
        }
        token = strtok(NULL, "/");
    }

    // Allocate memory for building the final canonical path
    char* result = (char*)malloc((len + 2) * sizeof(char));
    result[0] = '/';
    result[1] = '\0';

    // Construct the path from the stack contents
    for (int i = 0; i <= top; i++) {
        strcat(result, stack[i]);
        if (i < top) {
            strcat(result, "/");
        }
    }

    free(stack);
    return result;
}
