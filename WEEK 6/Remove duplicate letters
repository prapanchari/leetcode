#include <stdlib.h>
#include <string.h>

char* removeDuplicateLetters(char* s) {
    int len = strlen(s);
    int count[26] = {0};
    int visited[26] = {0};
    
    for (int i = 0; i < len; i++) {
        count[s[i] - 'a']++;
    }
    
    char* stack = (char*)malloc((len + 1) * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        int idx = s[i] - 'a';
        count[idx]--;
        
        if (visited[idx]) {
            continue;
        }
        
        while (top >= 0 && stack[top] > s[i] && count[stack[top] - 'a'] > 0) {
            visited[stack[top] - 'a'] = 0;
            top--;
        }
        
        stack[++top] = s[i];
        visited[idx] = 1;
    }
    
    stack[++top] = '\0';
    return stack;
}
