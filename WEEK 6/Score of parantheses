#include <stdio.h>
#include <string.h>

int scoreOfParentheses(char* s) {
    int score = 0;
    int depth = 0;
    int len = strlen(s);

    for (int i = 0; i < len; i++) {
        if (s[i] == '(') {
            depth++;
        } else {
            depth--;
            if (s[i - 1] == '(') {
                score += 1 << depth;
            }
        }
    }

    return score;
}
