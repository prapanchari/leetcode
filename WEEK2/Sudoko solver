#include <stdbool.h>

bool solve(char** board, int* rows, int* cols, int* boxes, int cell) {
    if (cell == 81) return true;
    
    int r = cell / 9;
    int c = cell % 9;
    
    if (board[r][c] != '.') {
        return solve(board, rows, cols, boxes, cell + 1);
    }
    
    int box_idx = (r / 3) * 3 + (c / 3);
    int used = rows[r] | cols[c] | boxes[box_idx];
    
    for (int num = 1; num <= 9; num++) {
        int mask = 1 << num;
        if (!(used & mask)) {
            board[r][c] = num + '0';
            rows[r] |= mask;
            cols[c] |= mask;
            boxes[box_idx] |= mask;
            
            if (solve(board, rows, cols, boxes, cell + 1)) {
                return true;
            }
            
            board[r][c] = '.';
            rows[r] &= ~mask;
            cols[c] &= ~mask;
            boxes[box_idx] &= ~mask;
        }
    }
    
    return false;
}

void solveSudoku(char** board, int boardSize, int* boardColSize) {
    int rows[9] = {0};
    int cols[9] = {0};
    int boxes[9] = {0};
    
    for (int r = 0; r < 9; r++) {
        for (int c = 0; c < 9; c++) {
            if (board[r][c] != '.') {
                int num = board[r][c] - '0';
                int mask = 1 << num;
                int box_idx = (r / 3) * 3 + (c / 3);
                
                rows[r] |= mask;
                cols[c] |= mask;
                boxes[box_idx] |= mask;
            }
        }
    }
    
    solve(board, rows, cols, boxes, 0);
}
