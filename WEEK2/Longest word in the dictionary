#include <string.h>
#include <stdlib.h>
#include <stdbool.h>

#define HASH_SIZE 2003

int compare(const void* a, const void* b) {
    const char* str1 = *(const char**)a;
    const char* str2 = *(const char**)b;
    int len1 = strlen(str1);
    int len2 = strlen(str2);
    
    if (len1 != len2) {
        return len1 - len2;
    }
    return strcmp(str2, str1);
}

typedef struct Node {
    char* word;
    struct Node* next;
} Node;

typedef struct {
    Node* bucket[HASH_SIZE];
} HashSet;

unsigned int hash(const char* str) {
    unsigned int h = 0;
    while (*str) {
        h = h * 31 + *str++;
    }
    return h % HASH_SIZE;
}

void insert(HashSet* set, char* word) {
    unsigned int h = hash(word);
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->word = word;
    newNode->next = set->bucket[h];
    set->bucket[h] = newNode;
}

bool contains(HashSet* set, const char* word) {
    unsigned int h = hash(word);
    Node* curr = set->bucket[h];
    while (curr) {
        if (strcmp(curr->word, word) == 0) {
            return true;
        }
        curr = curr->next;
    }
    return false;
}

char* longestWord(char** words, int wordsSize) {
    qsort(words, wordsSize, sizeof(char*), compare);
    
    HashSet set;
    memset(&set, 0, sizeof(HashSet));
    
    char* result = "";
    char prefix[31];

    for (int i = 0; i < wordsSize; i++) {
        int len = strlen(words[i]);
        
        if (len == 1) {
            insert(&set, words[i]);
            result = words[i];
        } else {
            strncpy(prefix, words[i], len - 1);
            prefix[len - 1] = '\0';
            
            if (contains(&set, prefix)) {
                insert(&set, words[i]);
                result = words[i];
            }
        }
    }
    
    return result;
}
