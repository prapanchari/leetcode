#include <string.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int characterReplacement(char* s, int k) {
    int len = strlen(s);
    int counts[26] = {0};
    int max_freq = 0;
    int max_len = 0;
    int left = 0;

    for (int right = 0; right < len; right++) {
        counts[s[right] - 'A']++;
        max_freq = MAX(max_freq, counts[s[right] - 'A']);

        if ((right - left + 1) - max_freq > k) {
            counts[s[left] - 'A']--;
            left++;
        }

        max_len = MAX(max_len, right - left + 1);
    }

    return max_len;
}
